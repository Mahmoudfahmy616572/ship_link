# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Keystore and signing
android/key.properties
android/upload-keystore.jks

# Supabase temp
supabase/.temp/

# Environment files
.env
.env.local
.env.*
!.env.example

# Local Gradle properties (may contain keys)
local.properties

# Firebase service account (never commit)
serviceAccountKey.json
*-firebase-adminsdk-*.json

# Firebase debug log
firebase-debug.log

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle caches (machine-specific, never commit)
**/.gradle/
**/buildOutputCleanup/
patched/**/.gradle/

# Android build reports
android/build/reports/
