{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "User App",
      "request": "launch",
      "type": "dart",
      "program": "lib/user/main_user.dart",
      "args": ["--flavor", "user", "--dart-define-from-file=.env"]
    },
    {
      "name": "Driver App",
      "request": "launch",
      "type": "dart",
      "program": "lib/driver/main_driver.dart",
      "args": ["--flavor", "driver", "--dart-define-from-file=.env"]
    },
    {
      "name": "Web App",
      "request": "launch",
      "type": "dart",
      "program": "lib/web/main_web.dart",
      "flutterMode": "debug"
    }
  ]
}
